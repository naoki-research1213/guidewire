// upstream BaseBeamInterpolation.inl:38; commit cac4005bd7c9f266c5c775ab88cebbd7c7fa83c7
void Interpolation::getControlPointsFromFrame(const Transform& global_H_local0, const Transform& global_H_local1,
    const Real L,
    Vec3& P0, Vec3& P1,
    Vec3& P2, Vec3& P3)
{
    P0 = global_H_local0.getOrigin();
    P3 = global_H_local1.getOrigin();

    P1 = P0 + global_H_local0.getOrientation().rotate(Vec3(1.0, 0, 0)) * (L / 3.0);
    P2 = P3 + global_H_local1.getOrientation().rotate(Vec3(-1, 0, 0)) * (L / 3.0);
}

